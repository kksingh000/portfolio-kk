{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/portfolio/**",
              "ui_kits/portfolio-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|active|interactive|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, active, interactive, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|solid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|iconLeft|iconRight|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, iconLeft, iconRight, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevation|interactive|focused|padding|theme|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, elevation, interactive, focused, padding, theme, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|contact|raised|float)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'contact' | 'raised' | 'float'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:deep)$/]",
        "message": "<Card> theme must be one of 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|href|copyable|theme|style|key|ref|className|style|children)$/]",
        "message": "<ContactLink> doesn't accept that prop. Declared props: label, value, href, copyable, theme, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactLink'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:deep)$/]",
        "message": "<ContactLink> theme must be one of 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|eyebrow|onClose|footer|children|width|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, eyebrow, onClose, footer, children, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|size|variant|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, size, variant, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|bare|circle)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'bare' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|value|onChange|placeholder|type|invalid|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, value, onChange, placeholder, type, invalid, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectFocusPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|category|cover|coverAlt|onEnlarge|width|style|key|ref|className|style|children)$/]",
        "message": "<ProjectFocusPanel> doesn't accept that prop. Declared props: name, category, cover, coverAlt, onEnlarge, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollCue'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|theme|style|key|ref|className|style|children)$/]",
        "message": "<ScrollCue> doesn't accept that prop. Declared props: label, theme, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollCue'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:deep)$/]",
        "message": "<ScrollCue> theme must be one of 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|children|align|theme|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: index, children, align, theme, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<SectionLabel> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:deep)$/]",
        "message": "<SectionLabel> theme must be one of 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|zone|leader|leaderSide|active|onHoverChange|style|key|ref|className|style|children)$/]",
        "message": "<TechChip> doesn't accept that prop. Declared props: children, zone, leader, leaderSide, active, onHoverChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechChip'] > JSXAttribute[name.name='zone'] > Literal[value!=/^(?:peak|upper|below-shallow|below-deep)$/]",
        "message": "<TechChip> zone must be one of 'peak' | 'upper' | 'below-shallow' | 'below-deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechChip'] > JSXAttribute[name.name='leaderSide'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<TechChip> leaderSide must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|rows|id|style|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, value, onChange, placeholder, rows, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placement|children|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, placement, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom|left|right)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom' | 'left' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
